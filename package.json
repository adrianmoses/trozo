{
  "name": "trozo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:all": "uvx honcho -e .env.local start",
    "build": "pnpm --filter web build",
    "test": "pnpm --recursive test",
    "lint": "pnpm --filter web lint",
    "format": "prettier --write . && pnpm --filter web exec eslint --fix",
    "check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
